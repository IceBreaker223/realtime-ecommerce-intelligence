# Compose reads .env automatically. Host Python scripts use process environment.
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce_user
POSTGRES_PASSWORD=ecommerce_password
# These defaults are for local development only.
# Optional host port overrides (container ports remain unchanged).
KAFKA_PORT=9092
POSTGRES_PORT=5432
API_PORT=8000
# New installations use Docker named volumes. Existing local data can use:
# KAFKA_STORAGE=./runtime/kafka-data
# SPARK_STORAGE=./runtime/spark-checkpoints
